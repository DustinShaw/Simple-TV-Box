<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: bright orange pill with a light rim (remote highlight). -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#F6A800"/>
            <stroke android:width="1dp" android:color="#FFE9B8"/>
        </shape>
    </item>
    <!-- Selected current section: dark orange tint with orange outline. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#5A3E00"/>
            <stroke android:width="1dp" android:color="#F6A800"/>
        </shape>
    </item>
    <!-- Default: subtle dark chip. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#1C1C1C"/>
            <stroke android:width="1dp" android:color="#333333"/>
        </shape>
    </item>
</selector>
